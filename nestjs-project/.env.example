# Application
NODE_ENV=development
PORT=3000

# Database (PostgreSQL)
DB_HOST=db
DB_PORT=5432
DB_USERNAME=streamtube
DB_PASSWORD=streamtube
DB_NAME=streamtube

# JWT
JWT_SECRET=change-me-in-production
JWT_REFRESH_SECRET=change-me-refresh-in-production
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d
CONFIRMATION_TOKEN_EXPIRATION_HOURS=1
PASSWORD_RESET_TOKEN_EXPIRATION_HOURS=1

# Mail (Mailpit for local development)
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_FROM='"StreamTube" <noreply@streamtube.com>'

# Queue (Redis / BullMQ) — Compose service name, never localhost
REDIS_HOST=redis
REDIS_PORT=6379
QUEUE_PREFIX=bull

# Object storage (S3-compatible / MinIO-Silo)
# S3_ENDPOINT is the internal Compose address used for every storage operation.
# S3_PUBLIC_ENDPOINT is the host-facing URL used only to presign URLs handed to clients outside Docker.
S3_ENDPOINT=http://minio:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=streamtube
S3_SECRET_ACCESS_KEY=streamtube-secret
S3_BUCKET=streamtube-videos

# Video processing
VIDEO_WORKER_CONCURRENCY=1
VIDEO_SWEEPER_INTERVAL_MS=900000
VIDEO_PROCESSING_STUCK_AFTER_MS=1800000
VIDEO_UPLOAD_EXPIRE_AFTER_MS=86400000
